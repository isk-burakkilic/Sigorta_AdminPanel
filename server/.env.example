# ============================================================
#  AHENK SIGORTA — BACKEND ENVIRONMENT (example)
#  Copy to server/.env and fill in real values.
#  server/.env is gitignored — NEVER commit real secrets.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated origins allowed to call the API with credentials (dev).
CORS_ORIGIN=http://localhost:5173

# ── Database (same schema as the original PHP app) ──────────
DB_HOST=localhost
DB_PORT=3306   # XAMPP MariaDB is often on 3307
DB_NAME=ahenk_db
DB_USER=ahenk_db
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

# ── SMTP (any mail server; 465=SSL/secure, 587=STARTTLS) ─────
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM=noreply@example.com
MAIL_NAME=Zenith Peak

# ── Auth / session ──────────────────────────────────────────
OTP_VALIDITY=300
MAX_ATTEMPTS=5
SESSION_NAME=zp_secure_session
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to 1 only when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0
# Session idle timeout in minutes (rolling; default 120 = 2h)
SESSION_IDLE_MIN=120

# ── Rate limiting (per IP, 15-minute window) ────────────────
# Strict guard on auth endpoints (login/verify-otp/profile) — brute-force defense.
RATE_LIMIT_AUTH=15
# Blanket limit across the whole /api surface.
RATE_LIMIT_API=2000

# ── Gemini AI (in-panel chatbot) ────────────────────────────
GEMINI_API_KEY=CHANGE_ME
