# ============================================================
#  AHENK SIGORTA — BACKEND ENVIRONMENT (example)
#  Copy to server/.env and fill in real values.
#  server/.env is gitignored — NEVER commit real secrets.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated origins allowed to call the API with credentials (dev).
CORS_ORIGIN=http://localhost:5173

# ── Database (same schema as the original PHP app) ──────────
DB_HOST=localhost
DB_PORT=3306   # XAMPP MariaDB is often on 3307
DB_NAME=ahenk_db
DB_USER=ahenk_db
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

# ── SMTP (any mail server; 465=SSL/secure, 587=STARTTLS) ─────
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM=noreply@example.com
MAIL_NAME=Zenith Peak

# ── Auth / session ──────────────────────────────────────────
OTP_VALIDITY=300
# (MAX_ATTEMPTS kaldırıldı — sayaç artık oturumda değil, kullanıcı adı ve IP
#  bazlı kalıcı kilitte tutuluyor. Bkz. aşağıdaki LOCKOUT_* ayarları.)
SESSION_NAME=zp_secure_session
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (NODE_ENV=production): the app REFUSES TO START if this
# is missing, still the placeholder, or shorter than 32 chars. Anyone who knows
# the signing key can forge a logged-in session cookie — i.e. reach the panel
# with nothing but its URL. There is deliberately no built-in fallback value.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to 1 only when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0
# Auto-logout after this many minutes with no user activity (server-enforced).
# The session cookie is also a browser-session cookie, and the session is bound
# to the tab that logged in — closing the tab ends access.
# The client reads this value from /api/auth/session — it is not hardcoded there.
SESSION_IDLE_MIN=60

# ── "Bu cihazı hatırla" (güvenilir cihaz) ───────────────────
# Kullanıcı giriş ekranında kutuyu işaretlerse, OTP'yi bir kez doğruladıktan
# sonra bu kadar gün boyunca o cihazda doğrulama kodu İSTENMEZ.
# Şifre yine her girişte sorulur — çerez tek başına giriş yapmaz.
# Kayıtlar server/data/trusted_devices.json içinde (yalnızca sha256 özetleri).
# 0 vermek yerine özelliği kapatmak için kullanıcılar kutuyu işaretlemesin.
TRUSTED_DAYS=30

# ── Session store (PRODUCTION: REQUIRED) ────────────────────
# Database that holds the `sessions` table (auto-created on boot).
# WITHOUT this, sessions live in process memory — and cPanel/Passenger restarts
# the app when idle and may run several workers, so users get randomly thrown
# out with "Oturum açılmamış". Point it at a small dedicated DB, e.g.
# cpaneluser_sessions (add the app user to it with ALL PRIVILEGES).
# Leave empty for local development.
SESSION_DB_NAME=

# ── Takip Edilen İşler — poliçe bitiş hatırlatmaları ────────
# Bir işin bitişine, kullanıcının seçtiği gün kadar kalınca acentenin TÜM
# çalışanlarına e-posta gider (SMTP ayarları yukarıdan kullanılır).
#
# ⚠️ ASIL GÜVENİLİR YOL cPanel CRON'DUR. Passenger boştaki uygulamayı uyutur;
#    süreç uyurken aşağıdaki timer da durur. Günde bir kez çalıştır:
#      cd ~/acentepanel_app/server && \
#      /opt/alt/alt-nodejs20/root/usr/bin/node scripts/send_reminders.mjs
#    Zamanlama: 0 9 * * *   (her gün 09:00)
#
# Uygulama içi tarama periyodu (dakika) — uygulama ayakta kaldığı sürece.
REMINDER_TICK_MIN=30
# Zil bildirimi çekilirken tetiklenen taramanın en sık aralığı (dakika).
REMINDER_MIN_INTERVAL_MIN=60
# 0 yaparsan uygulama içi zamanlayıcı hiç kurulmaz (cron'a bırakmak istersen).
REMINDERS_ENABLED=1

# ── Rate limiting (per IP) ──────────────────────────────────
# Strict guard on auth endpoints (login/verify-otp/profile) — 15-minute window.
RATE_LIMIT_AUTH=15
# Blanket limit across the whole /api surface — 15-minute window.
RATE_LIMIT_API=2000
# Burst guard: max requests per IP in a 10-SECOND window. This is what actually
# stops a flood; the 15-minute limit alone lets 2000 requests land in one second.
RATE_LIMIT_BURST=60
# Static asset limit per IP per minute (the SPA pulls many files — keep it loose).
RATE_LIMIT_STATIC=600

# ── Reverse proxy trust (SECURITY-CRITICAL) ─────────────────
# How many proxy hops sit in front of the app. Rate limiting and the brute-force
# lockout key on the client IP, and that IP comes from X-Forwarded-For ONLY when
# this is > 0. Set it WRONG-HIGH and an attacker forges the header to get a fresh
# IP per request, defeating every limit above.
#   cPanel / Passenger / nginx in front  -> 1
#   Node exposed directly on the port    -> 0
TRUST_PROXY=1

# ── Brute-force lockout (persistent; survives cookie drops + restarts) ──
# Failed logins are counted per USERNAME and per IP in data/lockouts.json.
# Username threshold is tight; the IP threshold is loose so a shared office
# NAT address doesn't lock out innocent colleagues.
LOCKOUT_USER_MAX=5
LOCKOUT_IP_MAX=25
# First lockout length in minutes; doubles on each repeat, capped at 24h.
LOCKOUT_MIN=15
# Wrong-code attempts allowed per issued OTP before the code is burned.
OTP_MAX_TRIES=5
# Unlock manually with: node scripts/unlock.mjs <username|ip>

# ── Request limits / slowloris defence ──────────────────────
# Max rows accepted in one Excel import request.
IMPORT_MAX_ROWS=20000
IMPORT_BODY_LIMIT=6mb
# Time allowed to send request headers / the full request / idle keep-alive.
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_KEEPALIVE_TIMEOUT_MS=10000
# Hard ceiling on concurrent sockets (0 = unlimited).
HTTP_MAX_CONNECTIONS=0

# ── Gemini AI (in-panel chatbot) ────────────────────────────
# Yalnızca Google Gemini ücretsiz katmanı (AI Studio) kullanılır — başka
# hiçbir sağlayıcı yok. aistudio.google.com'dan ücretsiz bir key alın.
GEMINI_API_KEY=CHANGE_ME
